# Hasil build
build/bin
/natapadu-app
# Isi hasil build diabaikan, tapi foldernya wajib ada:
# main.go memakai //go:embed all:frontend/dist, yang gagal kompilasi
# kalau direktorinya tidak ada sama sekali (checkout bersih di CI).
frontend/dist/*
!frontend/dist/.gitkeep

# Dependensi
node_modules

# Database lokal (data pengguna, jangan pernah ikut ter-commit)
*.db
*.db-wal
*.db-shm
